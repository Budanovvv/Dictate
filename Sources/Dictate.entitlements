<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required under the hardened runtime: without it the mic TCC request fails
         silently and the app never appears in Privacy → Microphone. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Same rule, same scar: under the hardened runtime a TCC request without
         its entitlement fails SILENTLY — no dialog, and the app never appears in
         the Privacy list at all (that is exactly how the microphone behaved
         before the key above was added). Reading calendars needs this one. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
